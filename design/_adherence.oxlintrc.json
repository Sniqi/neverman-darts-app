{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/display/**",
              "components/history/**",
              "components/scoring/**",
              "ui_kits/darts-app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Barlow|Barlow Semi Condensed))/i]",
        "message": "Font not provided by the design system. Available: Barlow, Barlow Semi Condensed."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|children|chevron|disabled|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, children, chevron, disabled, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:menu|accent|cta|destructive|cancel)$/]",
        "message": "<Button> variant must be one of 'menu' | 'accent' | 'cta' | 'destructive' | 'cancel'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:active|children|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: active, children, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ConfirmDialog'] > JSXAttribute > JSXIdentifier[name!=/^(?:heading|body|ctaLabel|ctaStyle|backdropDismiss|onConfirm|onCancel|key|ref|className|style|children)$/]",
        "message": "<ConfirmDialog> doesn't accept that prop. Declared props: heading, body, ctaLabel, ctaStyle, backdropDismiss, onConfirm, onCancel."
      },
      {
        "selector": "JSXOpeningElement[name.name='ConfirmDialog'] > JSXAttribute[name.name='ctaStyle'] > Literal[value!=/^(?:destructive|accent)$/]",
        "message": "<ConfirmDialog> ctaStyle must be one of 'destructive' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Dartboard'] > JSXAttribute > JSXIdentifier[name!=/^(?:onDart|style|key|ref|className|style|children)$/]",
        "message": "<Dartboard> doesn't accept that prop. Declared props: onDart, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DartScore'] > JSXAttribute > JSXIdentifier[name!=/^(?:segment|multiplier|key|ref|className|style|children)$/]",
        "message": "<DartScore> doesn't accept that prop. Declared props: segment, multiplier."
      },
      {
        "selector": "JSXOpeningElement[name.name='HistoryRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:date|winnerName|otherNames|result|format|onClick|key|ref|className|style|children)$/]",
        "message": "<HistoryRow> doesn't accept that prop. Declared props: date, winnerName, otherNames, result, format, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='MatchHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:startScore|outRule|setsEnabled|legsToWin|setsToWin|currentLeg|key|ref|className|style|children)$/]",
        "message": "<MatchHeader> doesn't accept that prop. Declared props: startScore, outRule, setsEnabled, legsToWin, setsToWin, currentLeg."
      },
      {
        "selector": "JSXOpeningElement[name.name='MatchHeader'] > JSXAttribute[name.name='outRule'] > Literal[value!=/^(?:single|double)$/]",
        "message": "<MatchHeader> outRule must be one of 'single' | 'double'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Numpad'] > JSXAttribute > JSXIdentifier[name!=/^(?:onConfirm|validate|key|ref|className|style|children)$/]",
        "message": "<Numpad> doesn't accept that prop. Declared props: onConfirm, validate."
      },
      {
        "selector": "JSXOpeningElement[name.name='PanelVisit'] > JSXAttribute > JSXIdentifier[name!=/^(?:darts|total|scoreAfter|bust|live|key|ref|className|style|children)$/]",
        "message": "<PanelVisit> doesn't accept that prop. Declared props: darts, total, scoreAfter, bust, live."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScoreCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|remaining|legs|sets|active|checkout|key|ref|className|style|children)$/]",
        "message": "<ScoreCard> doesn't accept that prop. Declared props: name, remaining, legs, sets, active, checkout."
      },
      {
        "selector": "JSXOpeningElement[name.name='SegmentedControl'] > JSXAttribute > JSXIdentifier[name!=/^(?:options|value|onChange|key|ref|className|style|children)$/]",
        "message": "<SegmentedControl> doesn't accept that prop. Declared props: options, value, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|key|ref|className|style|children)$/]",
        "message": "<StatCard> doesn't accept that prop. Declared props: label, value."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stepper'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|min|max|unit|onChange|key|ref|className|style|children)$/]",
        "message": "<Stepper> doesn't accept that prop. Declared props: label, value, min, max, unit, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='ToggleRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|checked|onChange|key|ref|className|style|children)$/]",
        "message": "<ToggleRow> doesn't accept that prop. Declared props: label, checked, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='VisitStrip'] > JSXAttribute > JSXIdentifier[name!=/^(?:darts|bust|onUndo|key|ref|className|style|children)$/]",
        "message": "<VisitStrip> doesn't accept that prop. Declared props: darts, bust, onUndo."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
